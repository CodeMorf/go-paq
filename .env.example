# ==========================================================
# GOPAQ PLATFORM CONFIGURATION TEMPLATE
# ==========================================================

# Application Environment
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Security (Generate secure random string in production)
JWT_SECRET=your_jwt_secret_here_min_32_chars
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration (PostgreSQL / PostGIS)
POSTGRES_USER=gopaq_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=gopaq_db
DATABASE_URL=postgresql://gopaq_user:your_secure_db_password@localhost:5432/gopaq_db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Karrio Multi-Carrier Engine (Optional)
KARRIO_API_URL=
KARRIO_API_KEY=

# Witylogix Last-Mile Engine (Optional, independently deployed AGPL service)
WITYLOGIX_SERVICE_URL=
WITYLOGIX_API_TOKEN=
WITYLOGIX_ORDERS_PATH=/api/orders
WITYLOGIX_DRIVERS_PATH=/api/drivers
WITYLOGIX_ROUTES_PATH=/api/routes
WITYLOGIX_HEALTH_PATH=/health
WITYLOGIX_TIMEOUT_MS=8000

# AI & Gemini API
GEMINI_API_KEY=
