# ==========================================================
# GOPAQ PLATFORM CONFIGURATION TEMPLATE
# ==========================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Security
JWT_SECRET=replace_with_a_random_secret_min_32_chars
SESSION_SECRET=replace_with_a_random_session_secret_min_32_chars
WEBHOOK_ENCRYPTION_KEY=64_hex_characters_for_aes_256_gcm
CORS_ORIGINS=http://localhost:3000
GOPAQ_PUBLIC_ORG_ID=org-gopaq

# GoPaq Core DB. Production requires PostgreSQL + PostGIS.
DATABASE_URL=
POSTGRES_USER=gopaq_app
POSTGRES_PASSWORD=generate_a_long_random_value
POSTGRES_DB=gopaq_production
REDIS_PASSWORD=generate_a_long_random_value
REDIS_URL=redis://localhost:6379
DEMO_ACCESS_ENABLED=false
SEED_DEV_DATA=false
PASSWORD_RESET_BASE_URL=
STORAGE_LOCAL_DIR=/app/data/uploads
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000

# Karrio self-hosted engine
KARRIO_TAG=2026.1.32
KARRIO_HTTP_PORT=5002
KARRIO_SECRET_KEY=replace_with_karrio_secret
KARRIO_DATABASE_NAME=karrio
KARRIO_DATABASE_USERNAME=karrio
KARRIO_DATABASE_PASSWORD=replace_karrio_db_password
KARRIO_API_URL=http://localhost:5002
# Create/bootstrap an API token in the self-hosted Karrio instance and place it here.
KARRIO_API_KEY=
KARRIO_TIMEOUT_MS=12000

# Witylogix independent AGPL service
# Pinned revision verified during integration; update intentionally after compatibility testing.
WITYLOGIX_GIT_REF=d73682793c8cd930065cee7fc710f4395f8e5784
WITYLOGIX_API_PORT=3001
WITYLOGIX_POSTGRES_USER=witylogix
WITYLOGIX_POSTGRES_PASSWORD=replace_witylogix_db_password
WITYLOGIX_POSTGRES_DB=witylogix
WITYLOGIX_JWT_SECRET=replace_with_witylogix_jwt_secret
WITYLOGIX_MAPBOX_ACCESS_TOKEN=
WITYLOGIX_SERVICE_URL=http://localhost:3001
# Bearer credential issued by the Witylogix deployment for GoPaq service access.
WITYLOGIX_API_TOKEN=
WITYLOGIX_TIMEOUT_MS=8000
WITYLOGIX_ORDERS_PATH=/api/v4/orders
WITYLOGIX_DRIVERS_PATH=/api/v4/drivers
WITYLOGIX_ROUTES_PATH=/api/v4/routes
WITYLOGIX_HEALTH_PATH=/health

# Optional AI
GEMINI_API_KEY=
